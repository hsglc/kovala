{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kovala",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "LADDER", "class_name": "Ladder" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Matchmaker"] },
    { "tag": "v2", "new_sqlite_classes": ["Ladder"] }
  ],
  "observability": { "enabled": true }
}
